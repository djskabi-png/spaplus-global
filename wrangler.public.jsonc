{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spaplus-global-public",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "app.spaplus.co/*",
      "zone_name": "spaplus.co"
    },
    {
      "pattern": "adir.spaplus.co",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spaplus-global-production",
      "database_id": "72b69593-1268-48a9-90fa-2a73dc1fd7c7"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "550515562646-kt2h4ajkajqhphptjq1uf8u84p4vmfmk.apps.googleusercontent.com"
  },
  "observability": {
    "enabled": true
  }
}
