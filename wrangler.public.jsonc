{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spaplus-global-public",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "app.spaplus.co/*",
      "zone_name": "spaplus.co"
    }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "SITES_API_ORIGIN": "https://spaplus-global-brand.adir-naor-7510.chatgpt.site"
  },
  "observability": {
    "enabled": true
  }
}
