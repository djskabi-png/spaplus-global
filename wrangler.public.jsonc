{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spaplus-global-public",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "app.spaplus.co/*",
      "zone_name": "spaplus.co"
    }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "550515562646-kt2h4ajkajqhphptjq1uf8u84p4vmfmk.apps.googleusercontent.com"
  },
  "observability": {
    "enabled": true
  }
}
